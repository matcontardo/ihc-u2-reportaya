  Operario [fillcolor="#fff1cc", color="#8a5a00"];
  Tecnico [label="Técnico de\nmantención", fillcolor="#fff1cc", color="#8a5a00"];
  Supervisor [label="Supervisor\nde línea", fillcolor="#fff1cc", color="#8a5a00"];
  Linea [label="Línea"];
